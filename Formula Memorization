<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>State Separation — Qubit Readout</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
<style>
  :root{
    --bg: #0A0A12;
    --panel: #131421;
    --panel-2: #171827;
    --border: #292B42;
    --border-soft: #1E2033;
    --text: #EDEDF7;
    --text-muted: #8D8FA8;
    --violet: #A78BFA;
    --violet-dim: #332C55;
    --pink: #FB7BAE;
    --pink-dim: #4A2438;
    --green: #4ADE80;
    --green-dim: #163A28;
    --red: #FB6B6B;
    --red-dim: #3E1F22;
    --mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    --sans: 'Space Grotesk', -apple-system, 'Segoe UI', sans-serif;
  }
  * { box-sizing: border-box; }
  html,body{
    margin:0; padding:0; background: var(--bg); color: var(--text);
    font-family: var(--sans); min-height: 100vh;
  }
  body{
    background-image: radial-gradient(circle at 20% 0%, rgba(167,139,250,0.08), transparent 45%),
                       radial-gradient(circle at 85% 15%, rgba(251,123,174,0.06), transparent 40%);
    background-color: var(--bg);
    padding: 28px 16px 60px;
  }
  .wrap{ max-width: 640px; margin: 0 auto; }

  header{ margin-bottom: 18px; }
  .eyebrow-row{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap;}
  h1{ font-size: clamp(26px, 6vw, 34px); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 4px; line-height:1.05; }
  h1 .accent{ color: var(--violet); }
  .subtitle{ color: var(--text-muted); font-size: 14.5px; margin: 0; }
  .statline{ font-family: var(--mono); font-size: 12.5px; color: var(--text-muted); text-align:right; white-space:nowrap; }
  .statline b{ color: var(--text); font-weight:600; }
  .statline .streak{ color: var(--pink); }

  /* IQ-plane style progress axis */
  .iqrow{ position: relative; height: 18px; margin: 18px 0 22px; }
  .iqrow::before{ content:''; position:absolute; left:0; right:0; top:50%; height:1px; background: var(--border); }
  .iqrow::after{ content:'I →'; position:absolute; right:0; top:-14px; font-family: var(--mono); font-size:10px; color: var(--border-soft); }
  .iq-fill{
    position:absolute; left:0; top:50%; height:2px; transform: translateY(-50%);
    background: var(--violet); box-shadow: 0 0 9px 1px rgba(167,139,250,0.6);
    transition: width .5s ease; width:0%;
  }
  .iq-dot{
    position:absolute; top:50%; width:9px; height:9px; border-radius:50%;
    background: var(--pink); box-shadow: 0 0 10px 3px rgba(251,123,174,0.65);
    transform: translate(-50%,-50%); transition: left .5s ease;
    left: 0%;
  }
  .iqrow.pulse .iq-dot{ animation: orbit 900ms ease; }
  @keyframes orbit{
    0%{ box-shadow: 0 0 10px 3px rgba(251,123,174,0.65); }
    40%{ box-shadow: 0 0 22px 8px rgba(74,222,128,0.85); }
    100%{ box-shadow: 0 0 10px 3px rgba(251,123,174,0.65); }
  }

  .modes{ display:flex; gap:8px; margin-bottom: 14px; }
  .modes button{
    flex:1; font-family: var(--mono); font-size: 13px; letter-spacing:.02em;
    background: var(--panel); color: var(--text-muted); border: 1px solid var(--border);
    padding: 10px 12px; border-radius: 6px; cursor: pointer; transition: .15s;
  }
  .modes button.active{ color: var(--bg); background: var(--violet); border-color: var(--violet); font-weight:600; }
  .modes button:hover:not(.active){ border-color: var(--violet); color: var(--text); }

  .filters{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom: 18px; }
  .chip{
    font-family: var(--mono); font-size: 11.5px; padding: 5px 10px; border-radius: 100px;
    border: 1px solid var(--border); color: var(--text-muted); cursor:pointer; background: transparent; transition: .15s;
  }
  .chip.on{ border-color: var(--pink); color: var(--pink); background: rgba(251,123,174,0.1); }

  .toggle-row{ display:flex; align-items:center; justify-content:space-between; margin-bottom: 18px; font-size: 13px; color: var(--text-muted); }
  .toggle-row label{ display:flex; align-items:center; gap:8px; cursor:pointer; user-select:none; }
  .switch{ width: 34px; height: 19px; border-radius: 100px; background: var(--border); position: relative; transition:.15s; flex-shrink:0; }
  .switch::after{ content:''; position:absolute; top:2px; left:2px; width:15px; height:15px; border-radius:50%; background: var(--text-muted); transition:.15s; }
  .switch.on{ background: var(--violet-dim); }
  .switch.on::after{ background: var(--violet); transform: translateX(15px); }
  .reset-link{ font-family: var(--mono); font-size:11.5px; color: var(--text-muted); background:none; border:none; cursor:pointer; text-decoration: underline; text-underline-offset:3px; }
  .reset-link:hover{ color: var(--red); }

  /* CARD — IQ crosshair corners */
  .card{
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 28px 24px; min-height: 220px; position: relative;
    display:flex; flex-direction:column; justify-content:center; gap: 14px; cursor: pointer;
  }
  .cross{ position:absolute; width:12px; height:12px; }
  .cross::before,.cross::after{ content:''; position:absolute; background: var(--border-soft); }
  .cross::before{ width:12px; height:1px; top:5px; left:0; }
  .cross::after{ width:1px; height:12px; left:5px; top:0; }
  .cross.tl{ top:10px; left:10px; } .cross.tr{ top:10px; right:10px; }
  .cross.bl{ bottom:10px; left:10px; } .cross.br{ bottom:10px; right:10px; }

  .card-meta{ display:flex; align-items:center; gap:10px; font-family: var(--mono); font-size:11.5px; color: var(--text-muted); }
  .tag{ padding:2px 8px; border-radius:100px; border:1px solid var(--border); }
  .card-title{ font-size: 19px; font-weight:600; line-height:1.3; }
  .formula-box{ font-size: 19px; padding: 6px 0; min-height: 40px; display:flex; align-items:center; overflow-x:auto; }
  .formula-box .katex{ font-size: 1.1em; }
  .flip-hint{ font-family: var(--mono); font-size: 11px; color: var(--text-muted); text-align:center; }

  .know-row{ display:flex; gap:10px; margin-top: 16px; }
  .know-row button{
    flex:1; font-family: var(--sans); font-weight:600; font-size: 14px; padding: 12px; border-radius:8px;
    border:1px solid var(--border); background: var(--panel-2); color: var(--text); cursor:pointer; transition:.15s;
  }
  .know-row .yes{ border-color: var(--green); color: var(--green); }
  .know-row .yes:hover{ background: var(--green-dim); }
  .know-row .no{ border-color: var(--red); color: var(--red); }
  .know-row .no:hover{ background: var(--red-dim); }

  .nav-row{ display:flex; justify-content:space-between; align-items:center; margin-top: 14px; }
  .nav-btn{ font-family: var(--mono); font-size:12px; color: var(--text-muted); background:none; border:none; cursor:pointer; }
  .nav-btn:hover{ color: var(--violet); }
  .pos-count{ font-family: var(--mono); font-size: 12px; color: var(--text-muted); }

  /* QUIZ */
  .quiz-prompt{ text-align:center; margin-bottom: 14px; }
  .quiz-prompt .tag{ display:inline-block; margin-bottom:8px; }
  .quiz-prompt .card-title{ font-size: 18px; }
  .options{ display:flex; flex-direction:column; gap:9px; }
  .option{
    text-align:left; background: var(--panel); border:1px solid var(--border); border-radius:8px;
    padding: 13px 14px; cursor:pointer; transition:.12s; display:flex; align-items:center; overflow-x:auto;
  }
  .option .katex{ font-size: 1.02em; }
  .option:hover:not(.locked){ border-color: var(--violet); }
  .option.correct{ border-color: var(--green); background: var(--green-dim); }
  .option.wrong{ border-color: var(--red); background: var(--red-dim); }
  .option.locked{ cursor:default; }
  .quiz-feedback{ font-family: var(--mono); font-size: 13px; text-align:center; margin-top: 12px; min-height: 20px; }
  .quiz-feedback.correct{ color: var(--green); }
  .quiz-feedback.wrong{ color: var(--red); }
  .next-btn{
    display:block; width:100%; margin-top: 12px; padding: 12px; border-radius:8px; border:1px solid var(--violet);
    background: var(--violet-dim); color: var(--violet); font-family: var(--sans); font-weight:600; font-size:14px;
    cursor:pointer; visibility:hidden;
  }
  .next-btn.show{ visibility: visible; }
  .next-btn:hover{ background: var(--violet); color: var(--bg); }

  .toast{
    position: fixed; left:50%; bottom: 24px; transform: translate(-50%, 20px);
    background: var(--panel-2); border:1px solid var(--green); color: var(--green);
    font-family: var(--mono); font-size: 12.5px; padding: 10px 16px; border-radius: 8px;
    opacity:0; transition: .3s ease; pointer-events:none; box-shadow: 0 0 24px rgba(74,222,128,0.25);
  }
  .toast.show{ opacity:1; transform: translate(-50%, 0); }

  .empty-state{ text-align:center; color: var(--text-muted); padding: 40px 10px; font-size:14px; }
  .empty-state b{ color: var(--green); }

  @media (max-width: 420px){
    .card{ padding: 22px 18px; }
    .card-title{ font-size: 16px; }
    .formula-box{ font-size: 16px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="eyebrow-row">
      <div>
        <h1>State <span class="accent">Separation</span></h1>
        <p class="subtitle">Qubit readout formula sheet — Hamiltonian → I/Q → GNU Radio.</p>
      </div>
      <div class="statline" id="statline"></div>
    </div>
  </header>

  <div class="iqrow" id="rail">
    <div class="iq-fill" id="railFill"></div>
    <div class="iq-dot" id="railDot"></div>
  </div>

  <div class="modes">
    <button id="modeStudy" class="active">Study</button>
    <button id="modeQuiz">Quiz</button>
  </div>

  <div class="filters" id="filters"></div>

  <div class="toggle-row">
    <label id="unmasteredToggle">
      <span class="switch" id="switchEl"></span>
      Only show unmastered
    </label>
    <button class="reset-link" id="resetBtn">reset progress</button>
  </div>

  <div id="stage"></div>
</div>

<div class="toast" id="toast"></div>

<script>
const DATA = [
  {t:"Qubit-Resonator Hamiltonian", c:"Quantum & Resonator", f:String.raw`H=\hbar\omega_q\sigma_+\sigma_-+\hbar\omega_r a^\dagger a+\hbar g(\sigma_+a+\sigma_-a^\dagger)`},
  {t:"Photon Number Operator", c:"Quantum & Resonator", f:String.raw`n=a^\dagger a`},
  {t:"Average Photon Number", c:"Quantum & Resonator", f:String.raw`\langle n\rangle=\langle a^\dagger a\rangle`},

  {t:"Microwave Drive Hamiltonian", c:"Microwave Drive", f:String.raw`H_{\text{drive}}(t)=A(a+a^\dagger)\cos(\omega_d t)`},

  {t:"Detuning", c:"Dispersive Readout", f:String.raw`\Delta=\omega_d-\omega_r`},
  {t:"Dispersive Shift", c:"Dispersive Readout", f:String.raw`\chi=\text{qubit-induced resonator frequency shift}`},
  {t:"Ground-State Hamiltonian", c:"Dispersive Readout", f:String.raw`H_g=\Delta n+\chi\sigma_z n+D(a+a^\dagger)`},
  {t:"Excited-State Hamiltonian", c:"Dispersive Readout", f:String.raw`H_e=\Delta n-\chi n+D(a+a^\dagger)`},

  {t:"Steady-State Density Matrix", c:"Steady State", f:String.raw`\rho_{\text{ss}}: \;\; \dot\rho_{\text{ss}}=0`},

  {t:"Readout Amplitude", c:"I/Q Readout", f:String.raw`\alpha=\langle a\rangle`},
  {t:"Complex I/Q Form", c:"I/Q Readout", f:String.raw`\alpha=I+jQ`},
  {t:"In-Phase Component", c:"I/Q Readout", f:String.raw`I=\operatorname{Re}(\alpha)`},
  {t:"Quadrature Component", c:"I/Q Readout", f:String.raw`Q=\operatorname{Im}(\alpha)`},

  {t:"State Separation", c:"State Separation", f:String.raw`d=|\alpha_g-\alpha_e|`},
  {t:"State Separation, Expanded", c:"State Separation", f:String.raw`d=\sqrt{(I_g-I_e)^2+(Q_g-Q_e)^2}`},

  {t:"Noisy In-Phase Measurement", c:"Noise", f:String.raw`I_{\text{meas}}=I+\eta_I`},
  {t:"Noisy Quadrature Measurement", c:"Noise", f:String.raw`Q_{\text{meas}}=Q+\eta_Q`},

  {t:"Complex I/Q Signal", c:"Complex Signal", f:String.raw`x=I+jQ`},
  {t:"I/Q Signal Magnitude", c:"Complex Signal", f:String.raw`|x|=\sqrt{I^2+Q^2}`},

  {t:"Nyquist Condition", c:"DSP / GNU Radio", f:String.raw`f_s>2f_{\max}`},
  {t:"Downsampling", c:"DSP / GNU Radio", f:String.raw`f_{s,\text{new}}=\dfrac{f_s}{N}`},
  {t:"FFT Frequency Resolution", c:"DSP / GNU Radio", f:String.raw`\Delta f=\dfrac{f_s}{N_{\text{FFT}}}`},
];

DATA.forEach((d,i) => d.id = i+1);
const CATS = [...new Set(DATA.map(d=>d.c))];

// ---------- state ----------
let mastery = {};
let stats = { reviews: 0, bestStreak: 0 };
let activeCats = new Set(CATS);
let onlyUnmastered = false;
let mode = 'study';

let studyQueue = [];
let studyPos = 0;
let cardFlipped = false;

let quizItem = null;
let quizOptions = [];
let quizAnswered = false;
let sessionStreak = 0;

// ---------- storage ----------
async function loadState(){
  try{
    const m = await window.storage.get('qubit-readout-mastery-v1');
    if(m && m.value) mastery = JSON.parse(m.value);
  }catch(e){ mastery = {}; }
  try{
    const s = await window.storage.get('qubit-readout-stats-v1');
    if(s && s.value) stats = JSON.parse(s.value);
  }catch(e){ /* defaults */ }
}
async function saveMastery(){
  try{ await window.storage.set('qubit-readout-mastery-v1', JSON.stringify(mastery)); }catch(e){}
}
async function saveStats(){
  try{ await window.storage.set('qubit-readout-stats-v1', JSON.stringify(stats)); }catch(e){}
}
function levelOf(id){ return mastery[id] || 0; }

// ---------- helpers ----------
function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}
function filteredData(){
  return DATA.filter(d => activeCats.has(d.c) && (!onlyUnmastered || levelOf(d.id) < 2));
}
function renderTex(el, tex, display=true){
  try{ katex.render(tex, el, { throwOnError:false, displayMode: display }); }
  catch(e){ el.textContent = tex; }
}
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=> t.classList.remove('show'), 2200);
}
function pulseRail(){
  const r = document.getElementById('rail');
  r.classList.remove('pulse'); void r.offsetWidth; r.classList.add('pulse');
}
function checkCategoryMastery(cat, prevKnownCount){
  const items = DATA.filter(d=>d.c===cat);
  const known = items.filter(d=>levelOf(d.id)===2).length;
  if(known === items.length && prevKnownCount < items.length){
    showToast(`Resolved: ${cat} — all ${items.length} locked in`);
    pulseRail();
  }
}

// ---------- top stat + rail ----------
function renderTopStats(){
  const total = DATA.length;
  const known = DATA.filter(d=>levelOf(d.id)===2).length;
  document.getElementById('statline').innerHTML =
    `<b>${known}</b>/${total} mastered &nbsp;·&nbsp; streak <span class="streak">${sessionStreak}</span> &nbsp;·&nbsp; best <span class="streak">${stats.bestStreak}</span>`;
  const pct = Math.round((known/total)*100);
  document.getElementById('railFill').style.width = pct + '%';
  document.getElementById('railDot').style.left = pct + '%';
}

// ---------- filters ----------
function renderFilters(){
  const box = document.getElementById('filters');
  box.innerHTML = '';
  CATS.forEach(cat=>{
    const chip = document.createElement('button');
    chip.className = 'chip' + (activeCats.has(cat) ? ' on' : '');
    chip.textContent = cat;
    chip.onclick = ()=>{
      if(activeCats.has(cat)){
        if(activeCats.size>1) activeCats.delete(cat);
      } else { activeCats.add(cat); }
      renderFilters();
      resetQueues();
    };
    box.appendChild(chip);
  });
}

// ---------- STUDY MODE ----------
function buildStudyQueue(){
  studyQueue = shuffle(filteredData().map(d=>d.id));
  studyPos = 0;
  cardFlipped = false;
}
function currentStudyItem(){
  if(studyQueue.length===0) return null;
  return DATA.find(d=>d.id===studyQueue[studyPos]);
}
function advanceStudy(){
  studyPos++;
  if(studyPos >= studyQueue.length){ buildStudyQueue(); }
  cardFlipped = false;
  renderStage();
}
function markCard(known){
  const item = currentStudyItem();
  if(!item) return;
  const prevKnown = DATA.filter(d=>d.c===item.c && levelOf(d.id)===2).length;
  const lvl = levelOf(item.id);
  mastery[item.id] = known ? Math.min(lvl+1, 2) : Math.max(lvl-1, 0);
  stats.reviews++;
  sessionStreak = known ? sessionStreak+1 : 0;
  if(sessionStreak > stats.bestStreak) stats.bestStreak = sessionStreak;
  saveMastery(); saveStats();
  checkCategoryMastery(item.c, prevKnown);
  renderTopStats();
  advanceStudy();
}
function levelLabel(lvl){ return lvl===2 ? 'known' : lvl===1 ? 'learning' : 'new'; }
function renderStudy(){
  const stage = document.getElementById('stage');
  const item = currentStudyItem();
  if(!item){
    stage.innerHTML = `<div class="empty-state">Nothing left in this filter.<br><b>Turn off "only unmastered"</b> or pick more categories.</div>`;
    return;
  }
  stage.innerHTML = `
    <div class="card" id="flipCard">
      <div class="cross tl"></div><div class="cross tr"></div>
      <div class="cross bl"></div><div class="cross br"></div>
      <div class="card-meta">
        <span class="tag">${item.c}</span>
        <span>#${item.id}</span>
        <span>·</span>
        <span>${levelLabel(levelOf(item.id))}</span>
      </div>
      <div class="card-title">${item.t}</div>
      <div class="formula-box" id="formulaBox" style="display:${cardFlipped?'flex':'none'}"></div>
      <div class="flip-hint">${cardFlipped ? '' : 'tap card to reveal the formula'}</div>
    </div>
    <div class="know-row" style="display:${cardFlipped?'flex':'none'}">
      <button class="no">Still learning</button>
      <button class="yes">I knew it</button>
    </div>
    <div class="nav-row">
      <button class="nav-btn" id="skipBtn">skip →</button>
      <span class="pos-count">${studyPos+1} / ${studyQueue.length}</span>
    </div>
  `;
  if(cardFlipped){ renderTex(document.getElementById('formulaBox'), item.f, true); }
  document.getElementById('flipCard').onclick = ()=>{
    if(cardFlipped) return;
    cardFlipped = true;
    renderStage();
  };
  const knowRow = stage.querySelector('.know-row');
  if(knowRow){
    knowRow.querySelector('.no').onclick = (e)=>{ e.stopPropagation(); markCard(false); };
    knowRow.querySelector('.yes').onclick = (e)=>{ e.stopPropagation(); markCard(true); };
  }
  document.getElementById('skipBtn').onclick = ()=>{ advanceStudy(); };
}

// ---------- QUIZ MODE ----------
function pickQuizItem(){
  const pool = filteredData();
  if(pool.length===0){ quizItem=null; return; }
  quizItem = pool[Math.floor(Math.random()*pool.length)];
  const distractPool = DATA.filter(d=>d.id!==quizItem.id && d.f!==quizItem.f);
  const distractors = shuffle(distractPool).slice(0,3);
  quizOptions = shuffle([quizItem, ...distractors]);
  quizAnswered = false;
}
function renderQuiz(){
  const stage = document.getElementById('stage');
  if(!quizItem){
    stage.innerHTML = `<div class="empty-state">Nothing left in this filter.<br><b>Turn off "only unmastered"</b> or pick more categories.</div>`;
    return;
  }
  stage.innerHTML = `
    <div class="quiz-prompt">
      <span class="tag">${quizItem.c} · #${quizItem.id}</span>
      <div class="card-title">${quizItem.t}</div>
    </div>
    <div class="options" id="optionsBox"></div>
    <div class="quiz-feedback" id="quizFeedback"></div>
    <button class="next-btn" id="nextQuizBtn">Next formula →</button>
  `;
  const box = document.getElementById('optionsBox');
  quizOptions.forEach(opt=>{
    const el = document.createElement('div');
    el.className = 'option';
    box.appendChild(el);
    renderTex(el, opt.f, false);
    el.onclick = ()=> answerQuiz(opt, el);
  });
}
function answerQuiz(opt, el){
  if(quizAnswered) return;
  quizAnswered = true;
  const correct = opt.id === quizItem.id;
  const prevKnown = DATA.filter(d=>d.c===quizItem.c && levelOf(d.id)===2).length;
  const lvl = levelOf(quizItem.id);
  mastery[quizItem.id] = correct ? Math.min(lvl+1,2) : Math.max(lvl-1,0);
  stats.reviews++;
  sessionStreak = correct ? sessionStreak+1 : 0;
  if(sessionStreak > stats.bestStreak) stats.bestStreak = sessionStreak;
  saveMastery(); saveStats();
  checkCategoryMastery(quizItem.c, prevKnown);
  renderTopStats();

  document.querySelectorAll('.option').forEach(node=> node.classList.add('locked'));
  el.classList.add(correct ? 'correct' : 'wrong');
  if(!correct){
    const idx = quizOptions.findIndex(o=>o.id===quizItem.id);
    document.querySelectorAll('.option')[idx].classList.add('correct');
  }
  const fb = document.getElementById('quizFeedback');
  fb.textContent = correct ? 'Correct.' : 'Not quite — correct answer highlighted.';
  fb.className = 'quiz-feedback ' + (correct ? 'correct' : 'wrong');
  document.getElementById('nextQuizBtn').classList.add('show');
  document.getElementById('nextQuizBtn').onclick = ()=>{
    pickQuizItem();
    renderStage();
  };
}

// ---------- stage router ----------
function renderStage(){
  if(mode==='study') renderStudy();
  else renderQuiz();
}
function resetQueues(){
  buildStudyQueue();
  pickQuizItem();
  renderTopStats();
  renderStage();
}

// ---------- controls ----------
document.getElementById('modeStudy').onclick = ()=>{
  mode='study';
  document.getElementById('modeStudy').classList.add('active');
  document.getElementById('modeQuiz').classList.remove('active');
  if(studyQueue.length===0) buildStudyQueue();
  renderStage();
};
document.getElementById('modeQuiz').onclick = ()=>{
  mode='quiz';
  document.getElementById('modeQuiz').classList.add('active');
  document.getElementById('modeStudy').classList.remove('active');
  if(!quizItem) pickQuizItem();
  renderStage();
};
document.getElementById('unmasteredToggle').onclick = ()=>{
  onlyUnmastered = !onlyUnmastered;
  document.getElementById('switchEl').classList.toggle('on', onlyUnmastered);
  resetQueues();
};
document.getElementById('resetBtn').onclick = async ()=>{
  if(!confirm('Reset all progress? This clears mastery levels and best streak.')) return;
  mastery = {}; stats = { reviews:0, bestStreak:0 }; sessionStreak = 0;
  await saveMastery(); await saveStats();
  resetQueues();
};

// ---------- init ----------
(async function init(){
  await loadState();
  renderFilters();
  buildStudyQueue();
  pickQuizItem();
  renderTopStats();
  renderStage();
})();
</script>
</body>
</html>
